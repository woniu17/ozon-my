{
  "name": "qxqx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "qxqx - cloakbrowser automation scripts",
  "main": "hello.js",
  "scripts": {
    "start": "node hello.js",
    "persistent": "node persistent.js",
    "extension": "node load-extension.js",
    "cdp": "node cdp-server.js",
    "cdp:ext": "CDP_EXTENSION=1 node cdp-server.js",
    "cdp:headless": "CDP_HEADLESS=1 node cdp-server.js",
    "backfill": "node backfill-store-stats.js",
    "backfill:fast": "INTERVAL_MS=3000 node backfill-store-stats.js",
    "shallow": "node shallow-collect.js",
    "price-watch": "node price-watch-collect.js",
    "state:export": "node state-transfer.js --export",
    "state:import": "node state-transfer.js --import"
  },
  "dependencies": {
    "cloakbrowser": "^0.5.9",
    "playwright-core": "^1.62.1"
  }
}
