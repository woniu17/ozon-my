# 无头浅度采集配置模板(shallow-collect.js)
# 复制为 .env 后按需修改;命令行/环境变量优先于 .env(dotenv 语义,不覆盖已有)

# ── 数据库 ──────────────────────────────────────
DB_PATH=../erp-backend-lite/data/erp.db

# ── 店铺过滤 ────────────────────────────────────
# 白名单(逗号分隔 sellerId),空=按条件筛选
STORE_SELLER_IDS=
# 仅中国大陆店铺(1=是,0=否)
STORE_ONLY_MAINLAND_CHINA=1
# 本批店铺数上限(测试用,0=不限)
STORE_LIMIT=0
# 排序字段(lastSeenAt/ordersCount/reviewsCount/rating/openedMonths)
STORE_SORT=lastSeenAt
# 重采间隔天数(0=done 永久有效,>0=N 天后重新采集)
REVISIT_DAYS=0
# 店铺数值范围过滤(空=不限;数据来自 backfill 回填的统计列,未回填的 NULL 会被过滤掉)
# 订单数范围
STORE_ORDERS_MIN=
STORE_ORDERS_MAX=
# 店铺评论数范围
STORE_REVIEWS_MIN=
STORE_REVIEWS_MAX=
# 店铺评分范围
STORE_RATING_MIN=
STORE_RATING_MAX=
# 开业时长范围(月)
STORE_OPENED_MONTHS_MIN=
STORE_OPENED_MONTHS_MAX=

# ── SKU 过滤(4 道过滤,与插件浅采语义一致) ──────
# 仅抓有评论(ratingCount>0)
SKU_ONLY_WITH_RATING=1
# 价格范围(空=不限)
SKU_PRICE_MIN=
SKU_PRICE_MAX=
# 评论数范围(空=不限)
SKU_RATING_MIN=
SKU_RATING_MAX=

# ── 引擎 ────────────────────────────────────────
# 无头模式(1=是,0=否)
HEADLESS=1
# 页间随机节流范围(默认 10-15 秒,反爬拟人化;店铺间隔复用同款)
PAGE_INTERVAL_MIN_MS=10000
PAGE_INTERVAL_MAX_MS=15000
# 单页 fetch 超时(ms)
REQUEST_TIMEOUT_MS=15000
# 连续空页上限(超过视为抓取完成,防御分页死循环)
MAX_EMPTY_PAGES=3
# 页级连续失败上限(触发熔断)
MAX_ERRORS=3

# ── 熔断恢复 ────────────────────────────────────
# 熔断后等待时间(默认 3 分钟,不直接失败)
CIRCUIT_BREAKER_WAIT_MS=180000
# 指数退避系数(1=固定等待,2=第2次熔断等2倍、第3次4倍…)
CIRCUIT_BREAKER_BACKOFF=1
# 同店连续熔断上限(0=永不放弃,一直重试;404 等永久错误不受此限)
MAX_CIRCUIT_BREAKS=0

# ── 写入 ────────────────────────────────────────
# 只跑不写(1=干跑:不写日志、不写 progress)
DRY_RUN=0
# SKU 逐条日志(1=每个 SKU 一行定宽输出:sku|名称(≤10字符)|价格|评分|评论数|PASS/SKIP原因)
LOG_SKU=0

# ── 链路对齐插件(仅通过过滤的 SKU) ──────────────
# 写 dom card 缓存(ozon_dom_cache)+ 索引聚合(ozon_cache_index,FTS 自动同步)
# 关闭(0)后仅写浅度日志,回到旧行为
WRITE_DOM_CACHE=1
# 入深度采集队列(collect_queue_tasks,pending;由插件 SW 轮询 claim 消费)
# 注意:全部入队(不做 24h 成功去重);插件未运行时任务积压为 pending 不丢失
ENQUEUE_DEPTH=1
