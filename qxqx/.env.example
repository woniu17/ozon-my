# 无头浅度采集配置模板(shallow-collect.js)
# 复制为 .env 后按需修改;命令行/环境变量优先于 .env(dotenv 语义,不覆盖已有)
# 2026-08 起走 ERP API(不再直连 SQLite),需后端已启动且 SERVICE_API_KEY 与 ERP_API_KEY 同值

# ── ERP 连接与鉴权 ──────────────────────────────
ERP_BASE_URL=http://127.0.0.1:3001
# 与后端 SERVICE_API_KEY 同值
ERP_API_KEY=
# 单请求超时(ms)
ERP_TIMEOUT_MS=15000
# 连续失败熔断阈值(达阈值暂停采集,每 30s 探测 /health 恢复后续采)
ERP_FAIL_MAX=5

# ── 店铺过滤 ────────────────────────────────────
# 白名单(逗号分隔 sellerId),空=按条件筛选
STORE_SELLER_IDS=
# 仅中国大陆店铺(1=是,0=否)
STORE_ONLY_MAINLAND_CHINA=1
# 本批店铺数上限(测试用,0=不限)
STORE_LIMIT=0
# 排序字段(lastSeenAt/ordersCount/reviewsCount/rating/openedMonths)
STORE_SORT=lastSeenAt
# 重采间隔天数(0=done 永久有效,>0=N 天后重新采集)
REVISIT_DAYS=0
# 店铺数值范围过滤(空=不限;数据来自 backfill 回填的统计列,未回填的 NULL 会被过滤掉)
# 订单数范围
STORE_ORDERS_MIN=
STORE_ORDERS_MAX=
# 店铺评论数范围
STORE_REVIEWS_MIN=
STORE_REVIEWS_MAX=
# 店铺评分范围
STORE_RATING_MIN=
STORE_RATING_MAX=
# 开业时长范围(月)
STORE_OPENED_MONTHS_MIN=
STORE_OPENED_MONTHS_MAX=

# ── SKU 过滤(4 道过滤,与插件浅采语义一致) ──────
# 仅抓有评论(ratingCount>0)
SKU_ONLY_WITH_RATING=1
# 价格范围(空=不限)
SKU_PRICE_MIN=
SKU_PRICE_MAX=
# 评论数范围(空=不限)
SKU_RATING_MIN=
SKU_RATING_MAX=

# ── 引擎 ────────────────────────────────────────
# 无头模式(1=是,0=否)
HEADLESS=1
# 页间随机节流范围(默认 10-15 秒,反爬拟人化;店铺间隔复用同款)
PAGE_INTERVAL_MIN_MS=10000
PAGE_INTERVAL_MAX_MS=15000
# 单页 fetch 超时(ms)
REQUEST_TIMEOUT_MS=15000
# 连续空页上限(超过视为抓取完成,防御分页死循环)
MAX_EMPTY_PAGES=3
# 页级连续失败上限(触发熔断)
MAX_ERRORS=3

# ── 熔断恢复 ────────────────────────────────────
# 熔断后等待时间(默认 3 分钟,不直接失败)
CIRCUIT_BREAKER_WAIT_MS=180000
# 指数退避系数(1=固定等待,2=第2次熔断等2倍、第3次4倍…)
CIRCUIT_BREAKER_BACKOFF=1
# 同店连续熔断上限(0=永不放弃,一直重试;404 等永久错误不受此限)
MAX_CIRCUIT_BREAKS=0

# ── 写入 ────────────────────────────────────────
# 只跑不写(1=干跑:不写日志、不写 progress)
DRY_RUN=0
# SKU 逐条日志(1=每个 SKU 一行定宽输出:sku|名称(≤10字符)|价格|评分|评论数|PASS/SKIP原因)
LOG_SKU=0

# ── 链路对齐插件(仅通过过滤的 SKU) ──────────────
# 写 dom card 缓存(ozon_dom_cache)+ 索引聚合(ozon_cache_index,FTS 自动同步)
# 关闭(0)后仅写浅度日志,回到旧行为
WRITE_DOM_CACHE=1
# 入深度采集队列(collect_queue_tasks,pending;由插件 SW 轮询 claim 消费)
# 注意:全部入队(不做 24h 成功去重);插件未运行时任务积压为 pending 不丢失
ENQUEUE_DEPTH=1

# ═══════════════════════════════════════════════
# 深度采集配置(deep-collect.js,走 ERP API,不直连数据库)
# 用法: node deep-collect.js            # 常驻消费队列
#       TASK_LIMIT=1 DRY_RUN=1 node deep-collect.js   # 单任务干跑
# 前置:ERP 后端已启动,且后端 .env 的 SERVICE_API_KEY 与此处 ERP_API_KEY 同值
# ═══════════════════════════════════════════════

# ── ERP 连接与鉴权 ──────────────────────────────
ERP_BASE_URL=http://127.0.0.1:3001
# 与后端 SERVICE_API_KEY 同值;生成:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ERP_API_KEY=
# 单请求超时(ms)
ERP_TIMEOUT_MS=15000
# 连续失败熔断阈值(达阈值暂停主循环,每 30s 探测 /health 恢复)
ERP_FAIL_MAX=5
# claim 空轮询间隔(ms)
CLAIM_EMPTY_WAIT_MS=60000

# ── 任务 ────────────────────────────────────────
# 本轮最多处理任务数(0=常驻不限;测试用 1/10/100 小批量)
TASK_LIMIT=0
# 干跑(1=不写缓存/日志/result,任务回 pending)
DRY_RUN=0
# SKU 逐条日志
LOG_SKU=0
# 浏览器 profile 目录(与浅采共用 .ozon-profile,靠锁文件互斥)
PROFILE_DIR=.ozon-profile

# ── 节流(反爬拟人化) ────────────────────────────
# SKU 间随机间隔(ms)
SKU_INTERVAL_MIN_MS=8000
SKU_INTERVAL_MAX_MS=15000

# ── 门控(1=开启,0=关闭;默认对齐插件当前生效值) ──
ENABLE_MARKET_STATS_GATE=1
ENABLE_CATEGORY_FILTER_GATE=1
ENABLE_ULTRA_LIGHT_GATE=1
ONLY_MAINLAND_CHINA=1

# ── 熔断/恢复等待 ───────────────────────────────
# ANTIBOT 触发后的暂停时长(默认 10 分钟,对齐插件熔断窗口)
ANTIBOT_WAIT_MS=600000
# challenge 页等待重试时长(ms)
CHALLENGE_WAIT_MS=15000
# 卖家中心未登录等待时长(等待人工扫码,默认 10 分钟)
SELLER_AUTH_WAIT_MS=600000
# AUTH_REQUIRED 重试上限(超限退出)
AUTH_RETRY_MAX=3

# ── 超时 ────────────────────────────────────────
# sellerPage 门户 API fetch 超时(marketStats/search/bundle)
PORTAL_FETCH_TIMEOUT_MS=20000
# buyerPage PDP 采集超时(媒体/跟卖/详情)
PDP_FETCH_TIMEOUT_MS=30000
# 页面导航超时(ms)
PAGE_GOTO_TIMEOUT_MS=30000
# 无头模式(1=是,0=有头便于调试)
HEADLESS=1
