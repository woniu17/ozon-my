# 服务端口
PORT=3002

# 日志级别: trace|debug|info|warn|error|fatal
LOG_LEVEL=info

# ── 数据库 ───────────────────────────────────────────────
# DB_DRIVER=sqlite(默认,零依赖,数据文件在 SQLITE_PATH)
DB_DRIVER=sqlite
SQLITE_PATH=./data/ozon-webhook.db

# MongoDB 配置(仅 DB_DRIVER=mongo 时生效,首批不实现)
MONGO_HOST=
MONGO_PORT=27017

# ── Ozon OPI(回拉订单/商品详情,与 erp-backend-lite 同源)──
OZON_OPI_BASE_URL=https://api-seller.ozon.ru
# 多店铺凭据:stores.json 已拷贝为本地副本(./src/config/stores.json),按 seller_id 路由
# 如需切换为 erp 实时配置,可改为 '../erp-backend-lite/src/config/stores.json'
STORES_CONFIG_PATH=./src/config/stores.json

# ── 服务身份(TYPE_PING 响应中的 version/name 字段)──
APP_NAME=ozon-webhook
APP_VERSION=1.0.0

# ── IP 白名单(开发时关闭即可绕过)──
IP_WHITELIST_ENABLED=true

# ── 飞书机器人(订单相关通知推送)──
# 货件取消走独立机器人,新订单/货件状态变更走另一机器人
# 揽收(posting_on_way_to_city)走独立机器人
# 留空则跳过飞书通知
FEISHU_WEBHOOK_URL_DEFAULT=https://open.feishu.cn/open-apis/bot/v2/hook/adaa3368-9e7a-4e15-911e-3c9f22b98e08
FEISHU_WEBHOOK_URL_CANCEL=https://open.feishu.cn/open-apis/bot/v2/hook/32867d9d-6a59-4ee8-85ee-8720224a5b4c
FEISHU_WEBHOOK_URL_NEW=https://open.feishu.cn/open-apis/bot/v2/hook/07ba7e5a-92c9-4f16-ac80-ace4c9a3c39d
FEISHU_WEBHOOK_URL_PICKUP=https://open.feishu.cn/open-apis/bot/v2/hook/2bc86f88-c8b6-4564-9943-8882302a8c14

# ── Poller 配置 ─────────────────────────────────────────
# 扫描间隔(毫秒)
POLLER_INTERVAL_MS=2000
# 单次扫描并发数(首批固定为 1)
POLLER_CONCURRENCY=1
# 最大重试次数,超过即标记 dead
POLLER_MAX_RETRY=5
