<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#f2f3f5">

    <!-- 顶部:tab(全部/待收货/签收) + 新增预采购/扫描签收 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#ffffff"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/preTabAll"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="全部"
                android:textSize="13sp"
                android:textColor="#86909c" />

            <TextView
                android:id="@+id/preTabPending"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="待收货"
                android:textSize="13sp"
                android:textColor="#86909c" />

            <TextView
                android:id="@+id/preTabReceived"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="签收"
                android:textSize="13sp"
                android:textColor="#86909c" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/preCreateBtn"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="+ 新增预采购"
                android:textColor="#ffffff"
                android:textSize="14sp"
                android:background="#165dff" />

            <TextView
                android:id="@+id/preScanReceiveBtn"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:gravity="center"
                android:text="扫描签收"
                android:textColor="#165dff"
                android:textSize="14sp"
                android:background="#e8f3ff" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/preSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#ffffff"
        android:paddingHorizontal="12dp"
        android:paddingBottom="8dp"
        android:text="共 0 笔 · 待收货 0 · 已签收 0"
        android:textColor="#86909c"
        android:textSize="12sp" />

    <ScrollView
        android:id="@+id/preListScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/preList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp" />
    </ScrollView>
</LinearLayout>
