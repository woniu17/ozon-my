<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="@dimen/card_padding"
    android:layout_marginBottom="12dp">

    <!-- 头部：店铺 + 货件号 + 状态 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/oStore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/primary"
            android:textSize="11sp"
            android:background="@drawable/bg_tag_blue"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp" />

        <TextView
            android:id="@+id/oPosting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="#1f2329"
            android:textSize="14sp"
            android:typeface="monospace"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/copyOrderPosting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="复制"
            android:textColor="#165dff"
            android:textSize="10sp"
            android:padding="4dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/oSplitBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="10sp"
            android:visibility="gone" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/oOpTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="11sp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="2dp" />
    </LinearLayout>

    <!-- 标签/备注区(2026-10-27,对齐 Web 行内编辑:展示+点击编辑) -->
    <LinearLayout
        android:id="@+id/oMetaContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical"
        android:background="#f7f8fa"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/oTags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="#4e5969"
            android:visibility="gone" />

        <TextView
            android:id="@+id/oNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="10sp"
            android:textColor="#4e5969"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 产品行容器 -->
    <LinearLayout
        android:id="@+id/oProdContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <!-- 采购物流轨迹容器(2026-10-17,动态填充 item_purchase 行) -->
    <LinearLayout
        android:id="@+id/oPurchaseContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone" />

    <!-- 底部：采购状态 + 金额/重量 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/oPurchaseTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp" />

        <TextView
            android:id="@+id/oArrivedTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/oFootAmts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="10sp"
            android:textColor="#1f2329"
            android:gravity="end" />
    </LinearLayout>

    <!-- 操作区（重量输入/提交发货/面单，动态填充） -->
    <LinearLayout
        android:id="@+id/oActionArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <!-- 时间行容器（动态填充） -->
    <LinearLayout
        android:id="@+id/oTimeContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#f7f8fa"
        android:padding="8dp"
        android:orientation="vertical" />

</LinearLayout>