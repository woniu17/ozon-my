<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#f2f3f5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#ffffff"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView android:id="@+id/ppcPlatPdd" android:layout_width="0dp" android:layout_height="36dp"
                android:layout_weight="1" android:gravity="center" android:text="拼多多" android:textSize="13sp" android:textColor="#86909c" />
            <TextView android:id="@+id/ppcPlat1688" android:layout_width="0dp" android:layout_height="36dp"
                android:layout_weight="1" android:gravity="center" android:text="1688" android:textSize="13sp" android:textColor="#86909c" />
            <TextView android:id="@+id/ppcPlatTaobao" android:layout_width="0dp" android:layout_height="36dp"
                android:layout_weight="1" android:gravity="center" android:text="淘宝" android:textSize="13sp" android:textColor="#86909c" />
            <TextView android:id="@+id/ppcPlatXianyu" android:layout_width="0dp" android:layout_height="36dp"
                android:layout_weight="1" android:gravity="center" android:text="闲鱼" android:textSize="13sp" android:textColor="#86909c" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView android:id="@+id/ppcHint" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="选择平台订单" android:textColor="#86909c" android:textSize="12sp" />
            <TextView android:id="@+id/ppcRefresh" android:layout_width="wrap_content" android:layout_height="32dp"
                android:gravity="center" android:paddingHorizontal="16dp" android:text="刷新" android:textSize="13sp"
                android:textColor="#165dff" android:background="#e8f3ff" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/ppcScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:id="@+id/ppcList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#ffffff"
        android:padding="10dp">

        <TextView android:id="@+id/ppcCancel" android:layout_width="0dp" android:layout_height="44dp"
            android:layout_weight="1" android:gravity="center" android:text="取消" android:textColor="#4e5969"
            android:textSize="14sp" android:background="#f2f3f5" />
        <TextView android:id="@+id/ppcSubmit" android:layout_width="0dp" android:layout_height="44dp"
            android:layout_weight="1" android:layout_marginStart="10dp" android:gravity="center"
            android:text="提交预采购" android:textColor="#ffffff" android:textSize="14sp" android:background="#165dff" />
    </LinearLayout>
</LinearLayout>
