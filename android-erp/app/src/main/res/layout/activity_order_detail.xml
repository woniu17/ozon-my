<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:background="@color/page_bg">

    <!-- 顶部标题栏：白底，与其他页面统一 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/card_bg"
        android:paddingHorizontal="12dp">

        <TextView
            android:id="@+id/detailBackBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹ 返回"
            android:textColor="@color/primary"
            android:textSize="15sp"
            android:padding="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="订单详情"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/detailSchemeDiagBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scheme诊断"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:padding="8dp" />

        <TextView
            android:id="@+id/detailRefreshBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="刷新"
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:padding="8dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="@color/divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/detailContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:paddingBottom="80dp">

            <!-- 头部卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#ffffff"
                android:padding="14dp"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/dStore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#165dff"
                        android:textSize="11sp"
                        android:background="#eef4ff"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/dOpTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textSize="11sp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/dPosting"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="14sp"
                        android:textColor="#1f2329"
                        android:typeface="monospace"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/dCopyPosting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="复制"
                        android:textColor="#165dff"
                        android:textSize="11sp"
                        android:padding="6dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/dSplitBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="10sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/dCountdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textSize="10sp"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/dTags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="10sp"
                    android:visibility="gone" />

                <!-- 利润概览条 -->
                <LinearLayout
                    android:id="@+id/dProfitStrip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#f7f8fa"
                    android:padding="8dp"
                    android:orientation="horizontal"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 主信息卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#ffffff"
                android:padding="14dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="订单信息"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#4e5969" />

                <LinearLayout
                    android:id="@+id/dInfoList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/dMoreToggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="更多订单信息 ›"
                    android:textSize="11sp"
                    android:textColor="#86909c"
                    android:padding="6dp" />

                <LinearLayout
                    android:id="@+id/dMoreInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 商品卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#ffffff"
                android:padding="14dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/dProdTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="商品"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#4e5969" />

                <LinearLayout
                    android:id="@+id/dProdContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- 采购关联卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#ffffff"
                android:padding="14dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/dPoTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="采购关联"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#4e5969" />

                <LinearLayout
                    android:id="@+id/dPoContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- 轨迹卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#ffffff"
                android:padding="14dp"
                android:layout_marginBottom="10dp"
                android:visibility="gone"
                android:id="@+id/dTraceCard">

                <TextView
                    android:id="@+id/dTraceTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="国内物流轨迹"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#4e5969" />

                <LinearLayout
                    android:id="@+id/dTraceContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/dTraceToggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="#165dff"
                    android:gravity="center"
                    android:padding="4dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 底部操作条 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="#ffffff">

        <LinearLayout
            android:id="@+id/dActionBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp" />
    </HorizontalScrollView>

</LinearLayout>