<?xml version="1.0" encoding="utf-8"?>
<!-- 财务统计（2026-10-16 重构）：整页改为单一 RecyclerView 滚动。
     汇总卡片/Tab/搜索作为 header item（header_finance.xml），明细列表由 RecyclerView 自身滚动，
     避免 ScrollView 内嵌 RecyclerView 展开全部 item 导致数据多时卡顿/滑动不了 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:background="@color/page_bg">

    <!-- 顶部标题栏：白底 + 品牌色返回 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#ffffff"
        android:paddingHorizontal="8dp">

        <TextView
            android:id="@+id/financeBackBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹ 返回"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingHorizontal="8dp"
            android:paddingVertical="12dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="财务统计"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/financeLogoutBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="退出"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="12dp" />
    </LinearLayout>

    <!-- 标题栏分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- 时间预设栏（第一行） -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="#ffffff"
        android:paddingTop="6dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/presetContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp" />
    </HorizontalScrollView>

    <!-- 月份快捷选择（第二行：最近4个月 + 更多） -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="#ffffff"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/monthContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp" />
    </HorizontalScrollView>

    <!-- 区间提示 + 时区 + 店铺 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/rangeHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="当前统计区间:全部时间"
            android:textSize="10sp"
            android:textColor="@color/text_muted"
            android:maxLines="2" />

        <TextView
            android:id="@+id/tzBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="北京时间 ▾"
            android:textSize="11sp"
            android:textColor="@color/primary"
            android:background="@drawable/bg_tag_blue"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp" />

        <TextView
            android:id="@+id/financeStoreBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="全部店铺 ▾"
            android:textSize="11sp"
            android:textColor="@color/primary"
            android:background="@drawable/bg_tag_blue"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- 明细列表：自身滚动（header 承载汇总/Tab/搜索） -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/financeRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="vertical" />

</LinearLayout>