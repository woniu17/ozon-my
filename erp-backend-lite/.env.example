# 服务端口
PORT=3001

# JWT 密钥(必填,随机长字符串)
JWT_SECRET=change-this-to-a-random-long-string

# 单用户账号(必填)
USER_PHONE=13800138000
# bcrypt hash of "password" —— 可用 node -e "console.log(require('bcryptjs').hashSync('password',10))" 生成
# 这里默认占位 "password" 的 hash
USER_PASSWORD=$2b$10$N9qo8uLOickgx2ZMRZoMyeIjZAgcfl7p92ldGxad68LJZdL17lhWy

# Ozon OPI(官方 API 跟卖用,可选)
OZON_OPI_BASE_URL=https://api-seller.ozon.ru

# 日志级别: trace|debug|info|warn|error|fatal
LOG_LEVEL=info

# ── 数据库驱动配置 ────────────────────────────────────────
# 缓存/采集日志/店铺分类/采集队列 的存储驱动
# - sqlite: 使用 SQLite(默认,零依赖,数据文件在 data/erp.db)
# - mongo:  使用 MongoDB(需配置 MONGO_* 参数)
DB_DRIVER=sqlite

# MongoDB 配置(仅 DB_DRIVER=mongo 时生效)
MONGO_HOST=
MONGO_PORT=27017
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=admin

# ── 图床配置（水印加工链用） ──────────────────────────────
# ERP 后端公网反代基址，用于拼接 public/images/ 下文件的公网访问 URL
# 不配置时：水印功能降级为透传原图（即使 listing_templates.applyWatermark=true 也不渲染）
# 配置示例（不带尾斜杠）：
# IMAGE_HOST_BASE_URL=https://2.tencent.yochylin.com:17443
IMAGE_HOST_BASE_URL=

# ── 图片处理代理配置（2026-07） ───────────────────────────
# 图片处理模式：
#   local  = 本地下载→渲染→落盘（默认，行为与改造前一致）
#   self   = HTTP POST 本机 /admin/api/image-host/process-batch（测试用，走完整远程链路）
#   remote = 转发远程 ERP 处理，返回公网 URL（本地无公网 IP 时使用）
# REMOTE_IMAGE_HOST_TOKEN 在本地机器(remote/self 模式)和远程机器(local 模式作为接收端)都需要配置,且两端必须一致
#   - 本地机器(remote/self 模式): 启动时强制校验,未配置则启动失败
#   - 远程机器(local 模式接收端): 启动不校验,但接收接口 /admin/api/image-host/process-batch 运行时校验,漏配将返回 500
# self 模式下 REMOTE_IMAGE_HOST_URL 缺省时自动填 http://localhost:{PORT}
# remote 模式下必须配置 REMOTE_IMAGE_HOST_URL（建议 HTTPS）
# 生成 token: openssl rand -hex 32 或 node -e "console.log(crypto.randomBytes(32).toString('hex'))"
IMAGE_HOST_MODE=local
REMOTE_IMAGE_HOST_URL=
REMOTE_IMAGE_HOST_TOKEN=

