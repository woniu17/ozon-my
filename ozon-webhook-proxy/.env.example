# 复制为 .env（服务器上是 /root/code/ozon-webhook-proxy/ozon-webhook-proxy.env，权限 600）
# 全部都有内置默认值，只写需要改的项即可。

# 监听：只绑回环，公网入口是 nginx 17443
LISTEN_ADDR=127.0.0.1:3002

# ERP 接收端点。用 apex 域名 yochylin.com 而不是 nuc.yochylin.com：
# 两者解析到同一台机器，但证书 SAN 只有 yochylin.com/www.yochylin.com。
TARGET_URL=https://yochylin.com:17443/webhook/ozon

# 落盘队列目录（相对路径按启动时的 cwd 解析，start.sh 里已固定）
SPOOL_DIR=/root/code/ozon-webhook-proxy/data/spool

# PING 回包身份，必须和 ERP 一致，否则 Ozon 后台看到的名字会变
APP_NAME=ozon-erp
APP_VERSION=2.0.0

# 转发节奏（异步，不影响 Ozon 侧时延）
FORWARD_TIMEOUT=8s
MAX_RETRIES=200
RETRY_MAX=5m
DRAIN_TIMEOUT=10s

# 告警阈值
ALERT_CONSEC_FAIL=5
ALERT_STALE_AFTER=10m

# 飞书机器人 hook token（只有 token，不带 URL 前缀）。留空则只打日志
FEISHU_BOT_TOKEN=

# 与 ERP 的共享密钥，第二阶段和 ERP 一起启用。留空则不带该头
PROXY_TOKEN=
