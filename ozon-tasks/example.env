# ozon-tasks 配置样例。复制成 .env 填真实值；.env 已在 .gitignore 里，别提交。
# 键名与 httpsrv 的 .env 完全同一方言，两个程序可以直接共用一份 .env。

# ---- Ozon 店铺凭据 ----
# 格式 name:clientId:apiKey，逗号分隔。太长可以拆成 OZON_SHOPS_1 / OZON_SHOPS_2 ...（按数字升序合并）
OZON_SHOPS=FAKE01:0000000:00000000-0000-0000-0000-000000000000,FAKE02:0000001:00000000-0000-0000-0000-000000000001

# ---- 排期（优先于冷却期）----
# 标准 5 段 cron（分 时 日 月 周），或 @daily/@hourly/@every 8h 这类别名，按时区本地时间解释。
# 禁止 4 段式和 6 段式（带秒）——那是最常见的配错来源，程序会拒绝启动而不是"看起来配了但从不触发"。
# 没配排期时退回 "@every <冷却期>"，与 JS 侧节拍一致，切换期可以只配冷却期不动排期。
OZON_TIMER_SCHEDULE=30 4 * * *
OZON_ACTION_DEACTIVATE_SCHEDULE=@every 1h

# ---- 定时器+最低价 分组 ----
# JSON 数组：name 组名(唯一) / shops 店铺名数组(必须存在于 OZON_SHOPS)
#            / schedule 可选(优先于 cooldown) / cooldown 可选 / feishuBot 可选
# cooldown 与 schedule 都只接受人性化时长 1d2h30m15s，写纯毫秒数会直接报错启动失败（和 JS 版一致，防手滑）
OZON_TIMER_GROUPS=[{"name":"groupA","shops":["FAKE01"],"schedule":"30 4 * * *","feishuBot":"OZON"}]

# ---- 促销活动商品移除 分组 ----
OZON_ACTION_DEACTIVATE_GROUPS=[{"name":"groupA","shops":["FAKE01","FAKE02"],"cooldown":"1h"}]

# 没配排期、分组里也没写时的回退冷却期（最小 1 分钟）
OZON_TIMER_COOLDOWN_MS=8h
OZON_ACTION_DEACTIVATE_COOLDOWN_MS=1h

# ---- 飞书通知 ----
# FEISHU_BOT_<别名> 的值必须是 webhook 末段的 UUID，程序会拼成完整 URL；分组里 feishuBot 填别名
FEISHU_BOT_OZON=00000000-0000-0000-0000-000000000000
FEISHU_WEBHOOK_URL=OZON
OZON_FEISHU_WEBHOOK_URL=OZON

# ---- 运行护栏 ----
# 同时在跑几家店（单店内部始终串行）。店铺多、网络好可以调到 4~5；再高容易撞 Ozon 限流。
OZON_TASK_CONCURRENCY=3
# 每店每秒请求数上限（Ozon 的配额按 client-id 算，所以桶是每店一个）。0 = 不限速（JS 侧行为）
OZON_API_RPS=5
# 突发桶容量：允许一小串独立读请求连发，不必先排队
OZON_API_BURST=5
# 租约 TTL：跑一轮超过它还没续上心跳就会被别的进程接管（心跳按 1/3 TTL 续）
OZON_TASK_LEASE=30m
# 上一轮失败后两次执行的最小间隔。成功过就不参与判定，所以不会把"每 2 小时"悄悄降成"每 10 小时"
OZON_TASK_BACKOFF=10m

# ---- 运行时 ----
# 接口根地址，默认就是官方值。只在演练时改：指向本地假服务就能在关掉 -dry-run 的情况下
# 验证真实写请求（改价 / 刷定时器 / 撤活动）会不会照预期落地。
# 非官方地址会在启动时打一条醒目警告——否则"演练通过"和"真的改了价"在日志里长得一样。
# OZON_API_BASE_URL=https://api-seller.ozon.ru

# MACHINE_NAME 写进台账和通知落款，多机排查时靠它认来源；缺省用主机名
# MACHINE_NAME=ozon-tasks
OZON_DB_PATH=data/ozon-tasks.db
# OZON_API_TIMEOUT_MS=15000
# OZON_HTTP_RETRIES=4
